<div class="ev ev-footer">
  <div class="ev-wrap">
    <div class="ev-footer__grid">
      <div>
        <div style="display:flex;align-items:center;gap:11px;margin-bottom:16px;">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 120 | image_tag: alt: shop.name, style: 'width:44px;height:44px;border-radius:8px;object-fit:contain;background:#fff;' }}
          {%- else -%}
            <div style="width:40px;height:40px;border-radius:50%;border:2px solid var(--ev-cyan);display:flex;align-items:center;justify-content:center;">💧</div>
          {%- endif -%}
          <div>
            <div style="font-family:'Syne',sans-serif;font-weight:800;font-size:1.1rem;">ELEVATE</div>
            <div class="ev-mono ev-cyan" style="font-size:.52rem;letter-spacing:.14em;">POOL &amp; SPA CARE</div>
          </div>
        </div>
        <p class="ev-muted" style="font-size:.82rem;max-width:280px;">{{ section.settings.tagline | escape }}</p>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <div class="ev-footer__h">{{ block.settings.heading | escape }}</div>
          <div class="ev-footer__links">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      <div>
        <div class="ev-footer__h">Store policies</div>
        <div class="ev-footer__links">
          {%- for policy in shop.policies -%}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endfor -%}
          {%- if shop.policies.size == 0 -%}<span class="ev-muted" style="font-size:.8rem;">Policies coming soon</span>{%- endif -%}
        </div>
      </div>
    </div>
    <div class="ev-div" style="margin:32px 0 22px;"></div>
    <div class="ev-footer__pay">
      <div class="ev-muted" style="font-size:.75rem;">🔒 Secure checkout · Card not charged until your order ships</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'ev-payicon' }}
        {%- endfor -%}
      </div>
    </div>
    <div class="ev-footer__bottom">
      <div>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</div>
      {%- if section.settings.credit != blank -%}<div>{{ section.settings.credit }}</div>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Elevate footer",
  "tag": "footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Spa supplies picked by the Elevate Landscape & Spas team in the south Denver metro, with how-to videos for every product." },
    { "type": "richtext", "id": "credit", "label": "Credit line", "default": "<p>Designed & maintained by <a href=\"https://vtekbizcorp.info/\" target=\"_blank\" rel=\"noopener\">VTEK Bizcorp & Media Labs</a></p>" }
  ],
  "blocks": [ { "type": "links", "name": "Link column", "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ] } ],
  "max_blocks": 3,
  "presets": [ { "name": "Elevate footer" } ]
}
{% endschema %}
