<section class="ev ev-trust">
  <div class="ev-wrap ev-trust__row">
    {%- for block in section.blocks -%}
      <div class="ev-trust__item" {{ block.shopify_attributes }}><span>{{ block.settings.icon }}</span><span>{{ block.settings.text | escape }}</span></div>
    {%- endfor -%}
  </div>
</section>
<div class="ev-div"></div>

{% schema %}
{
  "name": "Elevate trust bar",
  "tag": "div",
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "icon", "label": "Emoji / icon", "default": "✓" },
      { "type": "text", "id": "text", "label": "Text", "default": "Trust point" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Elevate trust bar" } ]
}
{% endschema %}
