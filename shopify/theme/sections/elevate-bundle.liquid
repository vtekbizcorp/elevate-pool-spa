{%- assign p = section.settings.product -%}
<section class="ev ev-sec">
  <div class="ev-wrap">
    <div class="ev-sec__head">
      <div class="ev-label ev-label--center">{{ section.settings.eyebrow | escape }}</div>
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- if p != blank -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      <div class="ev-bundle">
        <div>
          <div class="ev-label">What's in the kit</div>
          <div class="ev-bundle__list">
            {%- for block in section.blocks -%}
              <div class="ev-bundle__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</div>
            {%- endfor -%}
          </div>
        </div>
        <div class="ev-bundle__box">
          {%- if v.compare_at_price > v.price -%}
            <div class="ev-mono ev-small">BOUGHT SEPARATELY <span class="ev-price-old">{{ v.compare_at_price | money }}</span></div>
          {%- endif -%}
          <div class="ev-price">{{ v.price | money_without_trailing_zeros }}</div>
          {%- if v.compare_at_price > v.price -%}
            <div><span class="ev-save">✓ You save {{ v.compare_at_price | minus: v.price | money_without_trailing_zeros }}</span></div>
          {%- endif -%}
          {%- form 'product', p -%}
            <input type="hidden" name="id" value="{{ v.id }}">
            <button type="submit" class="ev-btn ev-btn--cyan ev-btn--block" {% unless v.available %}disabled{% endunless %}>🛒 {{ section.settings.button_label | escape }}</button>
          {%- endform -%}
          <div class="ev-small">{{ section.settings.small_print | escape }}</div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
<div class="ev-div"></div>

{% schema %}
{
  "name": "Elevate bundle",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Value bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The DIY Spa BioClean Kit." },
    { "type": "text", "id": "text", "label": "Text", "default": "Everything you need for a deep clean and biofilm purge, in one box." },
    { "type": "product", "id": "product", "label": "Bundle product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get the kit" },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "Ships across the lower 48 · 30-day returns on unopened items" }
  ],
  "blocks": [ { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Item" } ] } ],
  "max_blocks": 8,
  "presets": [ { "name": "Elevate bundle" } ]
}
{% endschema %}
